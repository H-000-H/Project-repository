# UI 层的 clangd 兜底参数 — 只"追加", 不覆盖编译库条目。
# 头文件在 compile_commands.json 里没有条目, clangd 靠"包含它的 .cpp"推断参数;
CompileFlags:
  Add:
    - '-DSTM32F407xx'
    - '-DUSE_FULL_LL_DRIVER'
    - '-DUSE_HAL_DRIVER'
    - '-DETL_NO_STL'
    - '-DCONFIG_OS_MINI_OS'
    - '-DLV_CONF_INCLUDE_SIMPLE'
    - '-DLV_LVGL_H_INCLUDE_SIMPLE'
    - '-DLV_KCONFIG_IGNORE'
    - '-mcpu=cortex-m4'
    - '-mfpu=fpv4-sp-d16'
    - '-mfloat-abi=hard'
    - '-ID:/device_platform/STM32F407ZG76/hal'
    - '-ID:/device_platform/STM32F407ZG76/hal/adc'
    - '-ID:/device_platform/STM32F407ZG76/hal/amp'
    - '-ID:/device_platform/STM32F407ZG76/hal/can'
    - '-ID:/device_platform/STM32F407ZG76/hal/dac'
    - '-ID:/device_platform/STM32F407ZG76/hal/gpio'
    - '-ID:/device_platform/STM32F407ZG76/hal/i2c'
    - '-ID:/device_platform/STM32F407ZG76/hal/i2s'
    - '-ID:/device_platform/STM32F407ZG76/hal/iwdg'
    - '-ID:/device_platform/STM32F407ZG76/hal/rtc'
    - '-ID:/device_platform/STM32F407ZG76/hal/spi'
    - '-ID:/device_platform/STM32F407ZG76/hal/storage'
    - '-ID:/device_platform/STM32F407ZG76/hal/system'
    - '-ID:/device_platform/STM32F407ZG76/hal/tim'
    - '-ID:/device_platform/STM32F407ZG76/hal/uart'
    - '-ID:/device_platform/STM32F407ZG76/hal/usb'
    - '-ID:/device_platform/STM32F407ZG76/hal/wwdg'
    - '-ID:/device_platform/STM32F407ZG76/ota-stm32f4'
