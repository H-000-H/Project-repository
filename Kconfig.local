# mini_tree Kconfig — 本地使用、不入库的扩展配置
# ============================================================
# 本文件由 Kconfig.non_esp (非 ESP 入口) 在本地可选 source,
# 不进 GitHub (.gitignore 屏蔽)。
# 公开配置树仍在 Kconfig.mini_tree, 本文件只追加本地扩展:
#   · OSAL 扩展后端 (ThreadX / uC-OS-III / uC-OS-II)
#   · TinyUSB OS port 的 ThreadX 选项
#   · UI 库胶水层 (LVGL / u8g2) 端口
#   · 网络扩展模块 (UDP / HTTP / TLS / altcp_tls)
#
# 这些模块在作者本地工作区可用, 但源码被 .gitignore 屏蔽,
# 不随仓库分发。使用方需自行 clone 对应库到 lib/<name>,
# 或按各库上游文档获取。
# ============================================================

menu "Local-only Extensions (not in git)"

menu "OSAL Extended Backends"
# 源码位置 (本地 clone, 不入库):
#   lib/threadx/        — Eclipse ThreadX v6.5.1
#   lib/uC-OS3/ + lib/uC-OS2/ + lib/uC-CPU/ + lib/uC-LIB/
#
# 这些后端在公开 Kconfig.mini_tree 的 OSAL choice 里不出现,
# 仅在本地 source 本文件后追加到 choice 末尾。
# 注意: choice 不能跨文件拆分, 因此本文件里的 OSAL 扩展后端
# 以独立 bool 形式存在 (不与公开 NULL/FREERTOS/RTTHREAD 互斥);
# 本地构建时请确保 .config 里只有一个 OSAL_*=y。

config OSAL_THREADX
    bool "Eclipse ThreadX (local, not in git)"
    select USB_TUSB_OS_THREADX
    help
      [本地模块, 不入库] 使用 Eclipse ThreadX (v6.5.1) 作为 OSAL 后端。
      源码需本地 clone 到 lib/threadx/ (路径与 lib/CMakeLists.txt 的
      add_subdirectory(threadx) 对齐)。
      许可 MIT (Eclipse 基金会托管, 商用友好)。
      端口按 Kconfig PLATFORM 自动派生 (lib/threadx/ports/cortex_*/gnu);
      内核配置见 lib/threadx/tx_user.h (1 ms tick + 栈检查)。
      板级集成: 需改写 ports/cortex_m4/gnu/example_build/ 下的
      tx_initialize_low_level.S (SysTick 1000 Hz) 并接线
      tx_kernel_enter() / tx_application_define()。
      任务控制块与栈由 OSAL 层 calloc 动态分配
      (RAM 占用最小, 见 docs/memory_footprint.md §3.1.1)。

config OSAL_UCOS_III
    bool "uC/OS-III (local, not in git)"
    select USB_TUSB_OS_NONE
    help
      [本地模块, 不入库] 使用 Micrium uC/OS-III (V3.08.02) 作为 OSAL 后端。
      源码需本地 clone 到 lib/uC-OS3/ + lib/uC-CPU/ + lib/uC-LIB/
      (weston-embedded, Apache-2.0)。
      TinyUSB 无 uC/OS 适配层, CFG_TUSB_OS 自动回退 None (裸机互斥)。
      项目配置副本 lib/uC-OS3/Cfg/ (os_cfg.h: DBG=1, 任务名入 TCB;
      os_cfg_app.h: OS_CFG_MSG_POOL_SIZE=256 — 全系统并发在途队列消息上限)。
      优先级 0 最高, 数小优先高; 队列传指针, OSAL 层自建定长槽环。
      板级集成: OSInit() → OSStart(), SysTick 挂 OS_CPU_SysTickHandler,
      ISR 包 OSIntEnter/OSIntExit。

config OSAL_UCOS_II
    bool "uC/OS-II (local, not in git)"
    select USB_TUSB_OS_NONE
    help
      [本地模块, 不入库] 使用 Micrium uC/OS-II (V2.93.01) 作为 OSAL 后端。
      源码需本地 clone 到 lib/uC-OS2/ + lib/uC-CPU/ + lib/uC-LIB/
      (weston-embedded, Apache-2.0)。
      TinyUSB 无 uC/OS 适配层, CFG_TUSB_OS 自动回退 None。
      注意: 每优先级仅允许一个任务 (0~63; 61/62/63 保留给 tmr/stat/idle),
      任务句柄即优先级号。项目配置副本 lib/uC-OS2/Cfg/
      (os_cfg.h: 1 ms tick、OS_MAX_EVENTS=24、OS_MAX_QS=8;
      app_cfg.h: 端口要求的 CPU_CFG_KA_IPL_BOUNDARY / NVIC_PRIO_BITS)。
      OS_EVENT 控制块来自内核池 (OS_MAX_EVENTS/OS_MAX_QS 为上限)。
      板级集成: OSInit() → OSStart(), SysTick 挂 OS_CPU_SysTickHandler,
      ISR 包 OSIntEnter/OSIntExit。

endmenu

config USB_TUSB_OS_THREADX_LOCAL
    bool
    default y if OSAL_THREADX
    help
      [本地模块] TinyUSB OS port 的 ThreadX 选项 (OPT_OS=4)。
      由 OSAL_THREADX 自动 select, 无需手填。
      公开 Kconfig.mini_tree 的 USB_TUSB_OS_* choice 不含 ThreadX 项,
      本符号供本地构建的 tusb_option.h 桥接使用。

menu "UI Libraries (LVGL / u8g2) — local port"
    # UI 库胶水层 (ui/) 配置。CMake 经 .config 的 CONFIG_UI_LVGL /
    # CONFIG_UI_U8G2 桥接决定是否 add_subdirectory(ui); 胶水层只经
    # device/VFS 模型 (DISPLAY_CMD_*) 触硬件。
    #
    # [本地模块, 不入库] 端口实现 (ui/lvgl/lvgl_port.c、ui/u8g2/u8g2_port.c、
    # ui/CMakeLists.txt) 在作者本地工作区, .gitignore 屏蔽;
    # 入库的只有 ui/display/display_ui_bridge.h 统一桥接头。
    # 使用方需自行按 display_ui_bridge.h 的契约补齐本地 port。

    config UI_LVGL
        bool "LVGL glue layer (ui/lvgl) — local port"
        default n
        help
          [本地模块, 不入库] 编入 ui/lvgl/lvgl_port.c 并链接 LVGL
          (mini_tree_link_lvgl, lv_conf.h 取 ui/lvgl/lv_conf.h)。
          胶水链路: lv_init + osal_time_ms tick + lv_display_create →
          DISPLAY_CMD_FLUSH (display_lvgl_flush_callback)。
          端口源码 ui/lvgl/ 不入库, 需本地补齐。

    config UI_LVGL_DISPLAY_COUNT
        int "LVGL display context count"
        default 1
        range 1 4
        depends on UI_LVGL
        help
          LVGL 显示上下文静态池容量 (可同时 attach 的屏数量)。

    config UI_LVGL_FLUSH_TIMEOUT_MS
        int "LVGL flush ioctl timeout (ms)"
        default 100
        range 0 10000
        depends on UI_LVGL
        help
          LVGL flush 回调内 device_ioctl(DISPLAY_CMD_FLUSH) 的超时 (毫秒)。

    config UI_U8G2
        bool "u8g2 glue layer (ui/u8g2) — local port"
        default n
        help
          [本地模块, 不入库] 编入 ui/u8g2/u8g2_port.c 并链接 u8g2
          (mini_tree_link_u8g2)。提供 u8x8 byte/gpio_and_delay 回调与
          u8g2_port_flush 整帧落屏 (display_u8g2_flush_frame_buffer →
          DISPLAY_CMD_FLUSH), 仅支持单色面板 (_f 整帧缓冲初始化过程)。
          端口源码 ui/u8g2/ 不入库, 需本地补齐。

    config UI_U8G2_FLUSH_TIMEOUT_MS
        int "u8g2 flush ioctl timeout (ms)"
        default 100
        range 0 10000
        depends on UI_U8G2
        help
          u8g2_port_flush 传 0 时使用的 device_ioctl 默认超时 (毫秒)。
endmenu

menu "Network Extended Modules (local, not in git)"
    # 网络扩展模块。入库的 net/ 只保留 MQTT / TCP / transport_glue /
    # pppif / usbethif 最小构建集; 下列模块在作者本地工作区可用,
    # 源码被 .gitignore 屏蔽, 不随仓库分发。
    # 使用方需自行按入库模块的契约 (NET_* 错误码、tcp_client FIFO 接口)
    # 补齐本地 port。

    menu "UDP Client (net/port/udp/udp_client.c)"
        depends on LWIP_UDP

        config UDP_CLIENT_RX_BUFFER_SIZE
            int "UDP client RX FIFO size (bytes, power of 2)"
            default 1024
            range 256 8192
            help
              [本地模块, 不入库] UDP 客户端
              (net/port/udp/udp_client.c) 每实例接收环形缓冲大小,
              必须为 2 的幂。静态嵌入 udp_client_context, 按实例数成倍占 RAM。
              发送为原子数据报 (pbuf 直发), 无 TX FIFO。

    endmenu

    menu "HTTP Client (net/port/http/http_client.c)"
        depends on LWIP_TCP

        config NET_HTTP_USE_COREHTTP
            bool "Use coreHTTP as HTTP protocol engine"
            default y
            help
              [本地模块, 不入库] 用 FreeRTOS coreHTTP (HTTP/1.1 全方法 +
              llhttp 解析) 做报文编解码, 包装层只留短连接请求流程。
              关闭后 HTTP 客户端不参与链接。

        config HTTP_CLIENT_RESPONSE_BUFFER_SIZE
            int "HTTP client response buffer size (bytes)"
            default 2048
            range 512 16384
            help
              HTTP 响应静态缓冲 (头 + 体共用), 需 >= 单次最大响应。

        config HTTP_CLIENT_RECV_TIMEOUT_MS
            int "HTTP client recv timeout (ms)"
            default 5000
            range 100 60000
            help
              单次请求等待响应的上限。
    endmenu

    menu "TLS (altcp_tls_mbedtls)"
        depends on LWIP_TCP

        config LWIP_ALTCP
            bool "Application-layer TCP abstraction (altcp)"
            default n
            help
              lwIP 应用层 TCP 抽象层 (altcp): 在 tcp_pcb 之上提供可叠加的
              分层连接接口, 是 TLS 层的前提。关闭时 altcp_* 全部宏退化为
              tcp_* 原生接口, 现有 TCP 代码零改动。
              开启 LWIP_ALTCP_TLS 时由 select 强制选中。

        config LWIP_ALTCP_TLS
            bool "TLS over altcp (https/mqtts capable)"
            default n
            select LWIP_ALTCP
            help
              altcp 之上的 TLS 层 (lwip/src/apps/altcp_tls)。开启后传输层
              可走加密通道, 供 https/mqtts 使用。需要 mbedTLS 库与较大的
              lwIP 堆 (建议 MEM_SIZE >= 32768)。

        config LWIP_ALTCP_TLS_MBEDTLS
            bool "mbedTLS backend for altcp TLS"
            default y if LWIP_ALTCP_TLS
            default n
            depends on LWIP_ALTCP_TLS
            help
              [本地模块, 不入库] altcp TLS 的 mbedTLS 实现
              (LWIP_ALTCP_TLS_MBEDTLS)。当前唯一后端, 开启时链接
              lib/mbedtls 并编入 altcp_tls_mbedtls 源文件。

        config TLS_TRANSPORT_RX_BUFFER_SIZE
            int "TLS transport RX FIFO size (bytes, power of 2)"
            default 2048
            range 512 16384
            depends on LWIP_ALTCP_TLS
            help
              [本地模块, 不入库] TLS 传输层
              (net/port/tls/tls_transport.c) 每实例接收环形缓冲大小,
              必须为 2 的幂。静态嵌入上下文, 按实例数成倍占 RAM。

        config TLS_TRANSPORT_TX_BUFFER_SIZE
            int "TLS transport TX FIFO size (bytes, power of 2)"
            default 2048
            range 512 16384
            depends on LWIP_ALTCP_TLS
            help
              [本地模块, 不入库] TLS 传输层每实例发送环形缓冲大小,
              必须为 2 的幂。
    endmenu

endmenu

endmenu
