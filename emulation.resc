mach create "stm32f407_platform"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery.repl

#挂载外设
machine LoadPlatformDescription @./emulation_peripheral.repl

# LED 电平变化日志是 Noisy 级别, 必须显式开启才能在 Renode 控制台看到
logLevel -1 gpioPortC.Led1
logLevel -1 gpioPortA.Button1
logLevel -1 gpioPortA.Button2
logLevel 3 sysbus.usart1
logLevel 3 sysbus.usart2
logLevel 3 sysbus.usart3

# 串口配置
emulation CreateServerSocketTerminal 9090 "terminal_uart"
connector Connect sysbus.usart2 terminal_uart

# OTA 固件流口 (USART3)
emulation CreateServerSocketTerminal 9091 "terminal_ota"
connector Connect sysbus.usart3 terminal_ota

# 业务通信口 (USART1, communicate): 独立于 console/OTA, 不接终端则数据进虚空
emulation CreateServerSocketTerminal 9092 "terminal_comm"
connector Connect sysbus.usart1 terminal_comm

# 载入 ELF 固件
sysbus LoadELF @build/Debug/STM32F407ZGT6.elf

# 开启 GDB Server，监听 3333 端口（注意：先不要加 start，让 GDB 挂载后再运行）
machine StartGdbServer 3333

# start gdb不主动start